<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trade With Vikas</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background-color: #f8f9fa;
            color: #333;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            background: #ffffff;
            width: 100%;
            max-width: 480px;
            padding: 40px 20px;
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            text-align: center;
        }
        .badge {
            background: #eef2ff;
            color: #4f46e5;
            font-size: 12px;
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 20px;
            display: inline-block;
            margin-bottom: 25px;
            letter-spacing: 0.5px;
        }
        .logo-circle {
            width: 110px;
            height: 110px;
            margin: 0 auto 25px auto;
            border-radius: 50%;
            background: linear-gradient(135deg, #4f46e5, #06b6d4);
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 8px 16px rgba(79, 70, 229, 0.2);
        }
        .logo-circle h2 {
            color: #ffffff;
            font-size: 24px;
            letter-spacing: 1px;
        }
        h1 {
            font-size: 22px;
            color: #111827;
            margin-bottom: 10px;
            font-weight: 700;
        }
        .subtitle {
            font-size: 14px;
            color: #6b7280;
            margin-bottom: 30px;
        }
        .description {
            font-size: 15px;
            color: #4b5563;
            line-height: 1.6;
            margin-bottom: 35px;
            padding: 0 10px;
        }
        .cta-btn {
            display: block;
            background: linear-gradient(135deg, #4f46e5, #6366f1);
            color: #ffffff;
            text-decoration: none;
            padding: 16px 20px;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .cta-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(79, 70, 229, 0.4);
        }
        .footer-text {
            font-size: 12px;
            color: #9ca3af;
            margin-top: 25px;
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="badge">🚀 AI ADS AGENCY COMMUNITY</div>
        
        <div class="logo-circle">
            <h2>AI</h2>
        </div>

        <h1>AI ADS AGENCY</h1>
        <p class="subtitle">Scale Your Business with AI-Powered Ads</p>

        <p class="description">
            Join our exclusive community to learn cutting-edge AI marketing strategies, automation tools, and high-converting ad techniques.
        </p>

        <a href="https://t.me/+o0mJLPaDDB1iMjll" target="_blank" class="cta-btn">
            📢 JOIN OUR TELEGRAM CHANNEL
        </a>

        <p class="footer-text">Tap the button above to open Telegram</p>
    </div>
<!-- Meta Pixel Code -->
